# Command line
# ------------------------------------------------------------------------------------------------

USAGE = f"""{PROGRAM} [options] inputfile outputfile
       {PROGRAM} --info inputfile"""

HELP = f"""Make a 3D model (typically a cave scan) smaller for sharing.

usage: {USAGE}

Input formats:  .glb .gltf .obj .ply .stl (and other formats trimesh can read)
Output formats: .glb (recommended), .obj, .ply, .stl; point clouds: .ply, .glb

Options:
  --ratio R              Keep this fraction of the triangles (or points), 0 < R <= 1.
                         Default 0.25. Use 1 for a lossless weld-and-repack only.
  --faces N              Target number of triangles (or points); overrides --ratio.
  --texture-size N       Shrink textures so that their longer side is at most N
                         pixels. Default 2048; 0 keeps the original size.
  --texture-quality Q    JPEG quality for the textures, 1-100. Default 80.
  --min-part-size N      Remove disconnected fragments with fewer than N triangles.
                         Default 0 (keep everything).
  --weld-distance D      Also merge vertices closer than D model units (usually
                         meters) to each other. Default 0 (exact duplicates only).
  --no-weld              Do not merge duplicate vertices (not recommended).
  --no-normals           Do not store vertex normals (smaller files, flat shading).
  --info                 Print information about the input file and exit.
  --force                Overwrite the output file without asking for confirmation.
  --quiet                Print only warnings and errors.
  --verbose              Print timing and per-texture details.
  --help                 Print this message.
  --version              Print version information.
"""


def parse_args(argv):
    parser = argparse.ArgumentParser(prog=PROGRAM, usage=USAGE, add_help=False)
    parser.add_argument("--ratio", type=float, default=0.25)
    parser.add_argument("--faces", type=int, default=None)
    parser.add_argument("--texture-size", type=int, default=2048)
    parser.add_argument("--texture-quality", type=int, default=80)
    parser.add_argument("--min-part-size", type=int, default=0)
    parser.add_argument("--weld-distance", type=float, default=0.0)
    parser.add_argument("--no-weld", dest="weld", action="store_false")
    parser.add_argument("--no-normals", dest="normals", action="store_false")
    parser.add_argument("--info", action="store_true")
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--quiet", action="store_true")
    parser.add_argument("--verbose", action="store_true")
    parser.add_argument("--help", action="store_true")
    parser.add_argument("--version", action="store_true")
    parser.add_argument("files", nargs="*")
    args = parser.parse_args(argv)
    if args.help:
        print(HELP, end="")
        sys.exit(0)
    if args.version:
        print(f"{PROGRAM} {VERSION}")
        sys.exit(0)
    if args.info:
        if len(args.files) != 1:
            fail(f"--info takes exactly one input file\nusage: {USAGE}")
    elif len(args.files) != 2:
        fail(f"expected an input file and an output file\nusage: {USAGE}")
    if not (0 < args.ratio <= 1):
        fail("--ratio must be between 0 (exclusive) and 1 (inclusive)")
    if args.faces is not None and args.faces < 1:
        fail("--faces must be positive")
    if not (1 <= args.texture_quality <= 100):
        fail("--texture-quality must be between 1 and 100")
    if args.texture_size < 0 or args.weld_distance < 0 or args.min_part_size < 0:
        fail("sizes and distances must not be negative")
    return args


def check_output(path, point_cloud, force):
    ext = ext_of(path)
    allowed = POINT_OUTPUT_FORMATS if point_cloud else MESH_OUTPUT_FORMATS
    if ext not in allowed:
        kind = "a point cloud" if point_cloud else "a mesh"
        fail(f"cannot write {kind} as '{ext or path}'; use one of: {' '.join(allowed)}")
    if os.path.exists(path) and not force:
        print(f"{PROGRAM}: warning: output file '{path}' already exists.", file=sys.stderr)
        if not sys.stdin.isatty():
            fail("not overwriting (use --force)")
        answer = input("Overwrite? [y/N] ").strip().lower()
        if answer not in ("y", "yes"):
            fail("not overwriting")
    directory = os.path.dirname(os.path.abspath(path))
    if not os.path.isdir(directory):
        fail(f"output directory '{directory}' does not exist")


def main(argv=None):
    global QUIET
    args = parse_args(sys.argv[1:] if argv is None else argv)
    QUIET = args.quiet
    input_path = args.files[0]
    if not os.path.isfile(input_path):
        fail(f"input file '{input_path}' does not exist")
    total = Timer()
    input_size = os.path.getsize(input_path)
    log(f"reading {input_path} ({human_size(input_size)})")
    t = Timer()
    model = load_model(input_path)
    texture_bytes = texture_bytes_in_file(input_path) if model.textured else 0
    log(f"input: {describe_model(model)}"
        + (f" taking {human_size(texture_bytes)}" if texture_bytes else "")
        + (f" ({t})" if args.verbose else ""))
    if args.info:
        return 0

    output_path = args.files[1]
    check_output(output_path, model.is_point_cloud, args.force)
    out_ext = ext_of(output_path)

    textures = []
    textured_input, point_cloud = model.textured, model.is_point_cloud
    if point_cloud:
        parts = reduce_point_cloud(model, args)
    else:
        materials, mesh = combine_parts(model)
        model.parts = []                # the per-part copies are no longer needed
        gc.collect()
        with tempfile.TemporaryDirectory(prefix=f"{PROGRAM}-") as tmpdir:
            mesh = simplify_mesh(mesh, materials, args, tmpdir)
        normals = vertex_normals(mesh["vertices"], mesh["faces"]) if args.normals else None
        parts = split_by_material(mesh["vertices"], mesh["faces"], mesh["wedge"], mesh["texnumber"],
                                  mesh["colors"], normals, materials)
        if out_ext in (".glb", ".obj"):
            textures = encode_textures(parts, args, before=texture_bytes)
        elif textured_input:
            log(f"note: {out_ext} output carries no textures; texture colors are baked into vertex colors"
                if out_ext == ".ply" else f"note: {out_ext} output carries no textures or colors")

    t = Timer()
    if out_ext == ".glb":
        write_glb(output_path, parts, textures, point_cloud=point_cloud)
    elif out_ext == ".obj":
        write_obj(output_path, parts, textures)
    elif out_ext == ".ply":
        write_ply(output_path, parts, with_normals=args.normals and not point_cloud)
    elif out_ext == ".stl":
        write_stl(output_path, parts)
    output_size = os.path.getsize(output_path)
    extra = ""
    if out_ext == ".obj" and textures:
        extra = f" plus {len(textures)} texture file{'s' if len(textures) != 1 else ''}"
    log(f"wrote {output_path}: {human_size(output_size)}{extra} "
        f"({100.0 * output_size / max(1, input_size):.1f}% of the input), {total} in total")
    return 0


if __name__ == "__main__":
    sys.exit(main())
