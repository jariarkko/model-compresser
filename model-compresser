def poisson_subsample(vertices, colors, target, tmpdir):
    """Evenly spaced subset of the points (MeshLab's Poisson-disk sampling), colors kept."""
    import pymeshlab

    pin = os.path.join(tmpdir, "points.ply")
    pout = os.path.join(tmpdir, "sampled.ply")
    write_interchange_ply(pin, vertices, np.zeros((0, 3), dtype=np.int32), None, None,
                          None if colors is None else colors[:, :3], 0)
    ms = pymeshlab.MeshSet()
    ms.load_new_mesh(pin)
    ms.generate_sampling_poisson_disk(samplenum=int(target), subsample=True)
    got = ms.current_mesh().vertex_number()
    if got > 0 and abs(got - target) > 0.02 * target:
        # MeshLab's disk radius estimate is rough for point clouds, but the count it
        # produces scales about linearly with the request, so one correction suffices
        ms.set_current_mesh(0)
        ms.generate_sampling_poisson_disk(samplenum=max(1, int(round(target * target / got))), subsample=True)
    ms.save_current_mesh(pout, binary=True, save_vertex_color=colors is not None,
                         save_vertex_normal=False, save_face_color=False)
    v = read_interchange_ply(pout)["vertex"]
    new_vertices = np.stack([v["x"], v["y"], v["z"]], axis=1).astype(np.float32)
    new_colors = None
    if colors is not None and "red" in v.dtype.names:
        new_colors = np.stack([v["red"], v["green"], v["blue"],
                               np.full(len(v), 255, np.uint8)], axis=1).astype(np.uint8)
    return new_vertices, new_colors


def reduce_point_cloud(model, args):
    vertices = np.concatenate([p.vertices for p in model.parts]).astype(np.float32)
    colors = None
    if model.colored:
        colors = np.concatenate([p.colors if p.colors is not None
                                 else np.full((len(p.vertices), 4), 255, np.uint8) for p in model.parts])
    target = compute_target_faces(len(vertices), args)
    if target < len(vertices):
        t = Timer()
        try:
            with tempfile.TemporaryDirectory(prefix=f"{PROGRAM}-") as tmpdir:
                vertices, colors = poisson_subsample(vertices, colors, target, tmpdir)
        except Exception as e:
            warn(f"MeshLab Poisson-disk sampling failed ({e}); picking points at random instead")
            keep = np.sort(np.random.default_rng(0).choice(len(vertices), size=target, replace=False))
            vertices = vertices[keep]
            if colors is not None:
                colors = colors[keep]
        log(f"subsampled points: {model.vertex_count:,} -> {len(vertices):,} "
            f"({100.0 * len(vertices) / model.vertex_count:.1f}%)"
            + (f" ({t})" if args.verbose else ""))
    else:
        log(f"no subsampling needed: {len(vertices):,} points is already within the target")
    return [Part("points", vertices, None, colors=colors, material=Material("points"))]


