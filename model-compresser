GL_ARRAY_BUFFER, GL_ELEMENT_ARRAY_BUFFER = 34962, 34963
GL_UNSIGNED_BYTE, GL_UNSIGNED_SHORT, GL_UNSIGNED_INT, GL_FLOAT = 5121, 5123, 5125, 5126


def write_glb(path, parts, textures, point_cloud=False):
    buf = bytearray()
    views, accessors = [], []

    def add_view(data, target=None):
        buf.extend(b"\0" * ((-len(buf)) % 4))
        view = {"buffer": 0, "byteOffset": len(buf), "byteLength": len(data)}
        if target is not None:
            view["target"] = target
        views.append(view)
        buf.extend(data)
        return len(views) - 1

    def add_accessor(array, component_type, kind, target, normalized=False, bounds=False):
        array = np.ascontiguousarray(array)
        acc = {"bufferView": add_view(array.tobytes(), target), "componentType": component_type,
               "count": int(len(array)), "type": kind}
        if normalized:
            acc["normalized"] = True
        if bounds:
            acc["min"] = [float(x) for x in array.min(axis=0)]
            acc["max"] = [float(x) for x in array.max(axis=0)]
        accessors.append(acc)
        return len(accessors) - 1

    texture_index = {id(t): i for i, t in enumerate(textures)}
    images = [{"bufferView": add_view(t.data), "mimeType": t.mime} for t in textures]
    materials, material_index, primitives = [], {}, []
    for part in parts:
        attrs = {"POSITION": add_accessor(part.vertices.astype(np.float32), GL_FLOAT, "VEC3",
                                          GL_ARRAY_BUFFER, bounds=True)}
        if part.normals is not None:
            attrs["NORMAL"] = add_accessor(part.normals.astype(np.float32), GL_FLOAT, "VEC3",
                                           GL_ARRAY_BUFFER)
        m = part.material
        tex = texture_index.get(id(m.texture)) if (m is not None and m.texture is not None) else None
        if part.uv is not None and tex is not None:
            uv = part.uv.astype(np.float32).copy()
            uv[:, 1] = 1.0 - uv[:, 1]              # glTF puts the texture origin top-left
            attrs["TEXCOORD_0"] = add_accessor(uv, GL_FLOAT, "VEC2", GL_ARRAY_BUFFER)
        if part.colors is not None:
            attrs["COLOR_0"] = add_accessor(part.colors.astype(np.uint8), GL_UNSIGNED_BYTE, "VEC4",
                                            GL_ARRAY_BUFFER, normalized=True)
        prim = {"attributes": attrs, "mode": 0 if point_cloud else 4}
        if part.faces is not None:
            if len(part.vertices) <= 65535:
                prim["indices"] = add_accessor(part.faces.ravel().astype(np.uint16), GL_UNSIGNED_SHORT,
                                               "SCALAR", GL_ELEMENT_ARRAY_BUFFER)
            else:
                prim["indices"] = add_accessor(part.faces.ravel().astype(np.uint32), GL_UNSIGNED_INT,
                                               "SCALAR", GL_ELEMENT_ARRAY_BUFFER)
        if m is not None:
            key = (id(m), tex)
            if key not in material_index:
                pbr = {"metallicFactor": 0.0, "roughnessFactor": float(m.roughness)}
                if tex is not None:
                    pbr["baseColorTexture"] = {"index": tex}
                if m.color is not None and (tex is None or tuple(m.color) != (1.0, 1.0, 1.0, 1.0)):
                    pbr["baseColorFactor"] = [float(c) for c in m.color]
                mat = {"name": m.name, "pbrMetallicRoughness": pbr}
                if m.double_sided:
                    mat["doubleSided"] = True
                material_index[key] = len(materials)
                materials.append(mat)
            prim["material"] = material_index[key]
        primitives.append(prim)

    gltf = {"asset": {"version": "2.0", "generator": f"{PROGRAM} {VERSION}"},
            "scene": 0, "scenes": [{"nodes": [0]}],
            "nodes": [{"mesh": 0, "name": os.path.splitext(os.path.basename(path))[0]}],
            "meshes": [{"primitives": primitives}],
            "accessors": accessors, "bufferViews": views, "buffers": [{"byteLength": 0}]}
    if materials:
        gltf["materials"] = materials
    if textures:
        gltf["images"] = images
        gltf["textures"] = [{"source": i} for i in range(len(images))]
    buf.extend(b"\0" * ((-len(buf)) % 4))
    gltf["buffers"][0]["byteLength"] = len(buf)
    js = json.dumps(gltf, separators=(",", ":")).encode("utf-8")
    js += b" " * ((-len(js)) % 4)
    with open(path, "wb") as f:
        f.write(struct.pack("<4sII", b"glTF", 2, 12 + 8 + len(js) + 8 + len(buf)))
        f.write(struct.pack("<II", len(js), 0x4E4F534A))
        f.write(js)
        f.write(struct.pack("<II", len(buf), 0x004E4942))
        f.write(buf)


def write_texture_files(path, textures):
    """Write textures next to an OBJ/PLY file; returns their file names."""
    stem = os.path.splitext(os.path.basename(path))[0]
    directory = os.path.dirname(path)
    names = []
    for i, t in enumerate(textures):
        name = f"{stem}_texture_{i}{t.ext}"
        with open(os.path.join(directory, name), "wb") as f:
            f.write(t.data)
        names.append(name)
    return names


def write_obj(path, parts, textures):
    names = write_texture_files(path, textures)
    texture_file = {id(t): n for t, n in zip(textures, names)}
    stem = os.path.splitext(os.path.basename(path))[0]
    mtl_name = stem + ".mtl"
    materials = {}
    for part in parts:
        if part.material is not None and id(part.material) not in materials:
            materials[id(part.material)] = part.material
    with open(os.path.join(os.path.dirname(path), mtl_name), "w") as f:
        f.write(f"# {PROGRAM} {VERSION}\n")
        for i, m in enumerate(materials.values()):
            color = m.color if m.color is not None else (1.0, 1.0, 1.0, 1.0)
            f.write(f"\nnewmtl {mtl_safe(m.name, i)}\n")
            f.write(f"Kd {color[0]:.4f} {color[1]:.4f} {color[2]:.4f}\nKa 0 0 0\nKs 0 0 0\nd 1\nillum 1\n")
            if m.texture is not None and id(m.texture) in texture_file:
                f.write(f"map_Kd {texture_file[id(m.texture)]}\n")
    with open(path, "w") as f:
        f.write(f"# {PROGRAM} {VERSION}\nmtllib {mtl_name}\n")
        offset = 0
        for pi, part in enumerate(parts):
            f.write(f"o {part.name.replace(' ', '_')}_{pi}\n")
            if part.colors is not None:
                np.savetxt(f, np.hstack([part.vertices, part.colors[:, :3] / 255.0]),
                           fmt="v %.6f %.6f %.6f %.4f %.4f %.4f")
            else:
                np.savetxt(f, part.vertices, fmt="v %.6f %.6f %.6f")
            has_uv = part.uv is not None and part.material is not None and part.material.texture is not None
            if has_uv:
                np.savetxt(f, part.uv, fmt="vt %.6f %.6f")
            if part.normals is not None:
                np.savetxt(f, part.normals, fmt="vn %.4f %.4f %.4f")
            if part.material is not None:
                mi = list(materials).index(id(part.material))
                f.write(f"usemtl {mtl_safe(part.material.name, mi)}\n")
            idx = part.faces.astype(np.int64) + 1 + offset
            if has_uv and part.normals is not None:
                np.savetxt(f, idx[:, [0, 0, 0, 1, 1, 1, 2, 2, 2]], fmt="f %d/%d/%d %d/%d/%d %d/%d/%d")
            elif has_uv:
                np.savetxt(f, idx[:, [0, 0, 1, 1, 2, 2]], fmt="f %d/%d %d/%d %d/%d")
            elif part.normals is not None:
                np.savetxt(f, idx[:, [0, 0, 1, 1, 2, 2]], fmt="f %d//%d %d//%d %d//%d")
            else:
                np.savetxt(f, idx, fmt="f %d %d %d")
            offset += len(part.vertices)


def mtl_safe(name, index):
    safe = "".join(c if c.isalnum() or c in "-_." else "_" for c in name)
    return f"{safe or 'material'}_{index}"


def write_ply(path, parts, with_normals):
    """Binary PLY with positions, optional normals, vertex colors and faces."""
    colored = any(p.colors is not None or (p.uv is not None and p.material is not None
                                           and p.material.image is not None) for p in parts)
    vfields = [("x", "<f4"), ("y", "<f4"), ("z", "<f4")]
    header = ["ply", "format binary_little_endian 1.0", f"comment {PROGRAM} {VERSION}"]
    props = ["property float x", "property float y", "property float z"]
    if with_normals:
        vfields += [("nx", "<f4"), ("ny", "<f4"), ("nz", "<f4")]
        props += ["property float nx", "property float ny", "property float nz"]
    if colored:
        vfields += [("red", "u1"), ("green", "u1"), ("blue", "u1")]
        props += ["property uchar red", "property uchar green", "property uchar blue"]
    varrs, farrs, offset = [], [], 0
    for part in parts:
        varr = np.empty(len(part.vertices), dtype=np.dtype(vfields))
        varr["x"], varr["y"], varr["z"] = part.vertices[:, 0], part.vertices[:, 1], part.vertices[:, 2]
        if with_normals:
            n = part.normals if part.normals is not None else np.zeros_like(part.vertices)
            varr["nx"], varr["ny"], varr["nz"] = n[:, 0], n[:, 1], n[:, 2]
        if colored:
            if part.colors is not None:
                c = part.colors
            elif part.uv is not None and part.material is not None and part.material.image is not None:
                c = bake_vertex_colors(part)
            else:
                c = np.full((len(part.vertices), 4), 255, np.uint8)
            varr["red"], varr["green"], varr["blue"] = c[:, 0], c[:, 1], c[:, 2]
        varrs.append(varr)
        if part.faces is not None:
            farr = np.empty(len(part.faces), dtype=np.dtype([("n", "u1"), ("v", "<i4", (3,))]))
            farr["n"] = 3
            farr["v"] = part.faces + offset
            farrs.append(farr)
        offset += len(part.vertices)
    nverts = sum(len(v) for v in varrs)
    nfaces = sum(len(f) for f in farrs)
    header += [f"element vertex {nverts}"] + props
    if nfaces or any(p.faces is not None for p in parts):
        header += [f"element face {nfaces}", "property list uchar int vertex_indices"]
    header += ["end_header", ""]
    with open(path, "wb") as f:
        f.write("\n".join(header).encode("ascii"))
        for v in varrs:
            f.write(v.tobytes())
        for fa in farrs:
            f.write(fa.tobytes())


def write_stl(path, parts):
    nfaces = sum(len(p.faces) for p in parts)
    dtype = np.dtype([("normal", "<f4", (3,)), ("v", "<f4", (3, 3)), ("attr", "<u2")])
    with open(path, "wb") as f:
        f.write(f"{PROGRAM} {VERSION}".encode("ascii").ljust(80, b"\0"))
        f.write(struct.pack("<I", nfaces))
        for part in parts:
            tri = part.vertices[part.faces].astype(np.float32)
            n = np.cross(tri[:, 1] - tri[:, 0], tri[:, 2] - tri[:, 0])
            length = np.linalg.norm(n, axis=1)
            n[length > 0] /= length[length > 0, None]
            arr = np.empty(len(tri), dtype=dtype)
            arr["normal"], arr["v"], arr["attr"] = n, tri, 0
            f.write(arr.tobytes())


