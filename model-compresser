import io
import json
import os
import struct
import sys
import tempfile
import time
from dataclasses import dataclass, field

import numpy as np

PROGRAM = "model-compresser"
VERSION = "0.1.0"

MESH_OUTPUT_FORMATS = (".glb", ".obj", ".ply", ".stl")
POINT_OUTPUT_FORMATS = (".glb", ".ply")

QUIET = False


# ------------------------------------------------------------------------------------------------
# Small helpers
# ------------------------------------------------------------------------------------------------

def log(text):
    if not QUIET:
        print(f"{PROGRAM}: {text}", flush=True)


def warn(text):
    print(f"{PROGRAM}: warning: {text}", file=sys.stderr, flush=True)


def fail(text, status=1):
    print(f"{PROGRAM}: error: {text}", file=sys.stderr, flush=True)
    sys.exit(status)


def human_size(nbytes):
    nbytes = float(nbytes)
    for unit in ("bytes", "kB", "MB", "GB"):
        if nbytes < 1000 or unit == "GB":
            return f"{nbytes:.0f} {unit}" if unit == "bytes" else f"{nbytes:.1f} {unit}"
        nbytes /= 1000.0


def ext_of(path):
    return os.path.splitext(path)[1].lower()


class Timer:
    def __init__(self):
        self.start = time.time()

    def __str__(self):
        return f"{time.time() - self.start:.1f} s"


# ------------------------------------------------------------------------------------------------
# In-memory model: a list of parts, each with one material
# ------------------------------------------------------------------------------------------------

@dataclass
class Texture:
    data: bytes
    mime: str
    ext: str
    size: tuple


@dataclass
class Material:
    name: str
    image: object = None          # PIL.Image.Image, or None
    color: tuple = None           # RGBA, floats in 0..1, or None
    double_sided: bool = False
    roughness: float = 1.0
    texture: Texture = None       # filled in when textures are encoded for output


@dataclass
class Part:
    name: str
    vertices: np.ndarray          # (n, 3) float32
    faces: np.ndarray = None      # (m, 3) int32; None for a point cloud
    uv: np.ndarray = None         # (n, 2) float32, OBJ convention (origin bottom-left)
    colors: np.ndarray = None     # (n, 4) uint8
    normals: np.ndarray = None    # (n, 3) float32
    material: Material = None


@dataclass
class Model:
    parts: list = field(default_factory=list)

    @property
    def is_point_cloud(self):
        return all(p.faces is None for p in self.parts)

    @property
    def vertex_count(self):
        return sum(len(p.vertices) for p in self.parts)

    @property
    def triangle_count(self):
        return sum(len(p.faces) for p in self.parts if p.faces is not None)

    @property
    def textured(self):
        return any(p.uv is not None and p.material is not None and p.material.image is not None
                   for p in self.parts)

    @property
    def colored(self):
        return any(p.colors is not None for p in self.parts)

    def images(self):
        """The distinct texture images, in first-use order."""
        seen, result = set(), []
        for p in self.parts:
            img = p.material.image if p.material is not None else None
            if img is not None and id(img) not in seen:
                seen.add(id(img))
                result.append(img)
        return result


# ------------------------------------------------------------------------------------------------
# Reading
# ------------------------------------------------------------------------------------------------

def convert_material(mat):
    """Turn a trimesh material (PBR or OBJ-style simple material) into ours."""
    if mat is None:
        return Material("material")
    name = getattr(mat, "name", None) or "material"
    image = getattr(mat, "baseColorTexture", None)
    if image is None:
        image = getattr(mat, "image", None)
    factor = getattr(mat, "baseColorFactor", None)
    if factor is None and image is None:
        try:
            factor = mat.main_color
        except Exception:
            factor = None
    color = None
    if factor is not None:
        f = np.asarray(factor, dtype=np.float64).ravel()
        if f.size >= 3:
            if f.max() > 1.0:
                f = f / 255.0
            color = (float(f[0]), float(f[1]), float(f[2]), float(f[3]) if f.size > 3 else 1.0)
    roughness = getattr(mat, "roughnessFactor", None)
    roughness = 1.0 if roughness is None else float(roughness)
    return Material(name, image, color, bool(getattr(mat, "doubleSided", False)), roughness)


def load_model(path):
    import trimesh

    ext = ext_of(path)
    if ext in (".usdz", ".usd", ".usda", ".usdc"):
        fail(f"'{path}': USD files are not supported; export the model as GLB or OBJ first "
             "(e.g. with Blender or Apple's Reality Converter)")
    try:
        scene = trimesh.load(path, force="scene", process=False)
    except Exception as e:
        fail(f"cannot read '{path}': {e}")

    model = Model()
    # Walk the scene graph and apply the node transforms ourselves rather than using
    # scene.dump(): dump() copies every geometry, and copying a material decodes its
    # texture at full resolution -- gigabytes for a scan with many 8192x8192 images.
    graph = scene.graph
    for node_name in graph.nodes_geometry:
        transform, geometry_name = graph[node_name]
        geom = scene.geometry.get(geometry_name)
        if geom is None:
            continue
        name = geometry_name or node_name or f"part{len(model.parts)}"
        vertices = np.asarray(geom.vertices, dtype=np.float64)
        if len(vertices) == 0:
            continue
        if transform is not None and not np.allclose(transform, np.eye(4)):
            matrix = np.asarray(transform, dtype=np.float64)
            vertices = vertices @ matrix[:3, :3].T + matrix[:3, 3]
        vertices = vertices.astype(np.float32)
        if isinstance(geom, trimesh.PointCloud):
            colors = None
            try:
                c = np.asarray(geom.colors, dtype=np.uint8)
                if c.shape == (len(vertices), 4):
                    colors = c
            except Exception:
                pass
            model.parts.append(Part(name, vertices, None, colors=colors))
            continue
        if not isinstance(geom, trimesh.Trimesh):
            warn(f"skipping '{name}': unsupported geometry type {type(geom).__name__}")
            continue
        faces = np.asarray(geom.faces, dtype=np.int32)
        if len(faces) == 0:
            model.parts.append(Part(name, vertices, None))
            continue
        uv = colors = None
        material = None
        visual = getattr(geom, "visual", None)
        kind = getattr(visual, "kind", None)
        if kind == "texture":
            uv = getattr(visual, "uv", None)
            if uv is not None:
                uv = np.asarray(uv, dtype=np.float32)
                if uv.shape != (len(vertices), 2):
                    uv = None
            material = convert_material(getattr(visual, "material", None))
        elif kind in ("vertex", "face"):
            colors = np.asarray(visual.vertex_colors, dtype=np.uint8)
            if colors.shape != (len(vertices), 4):
                colors = None
        if material is None:
            material = Material("material")
        if material.image is None:
            uv = None           # texture coordinates are useless without a texture
        model.parts.append(Part(name, vertices, faces, uv=uv, colors=colors, material=material))

    # trimesh's objects form reference cycles that keep the file buffer and float64
    # copies of everything alive; collect them now, not in the middle of MeshLab's work
    del scene, graph
    gc.collect()
    if not model.parts:
        fail(f"'{path}': no geometry found")
    if any(p.faces is None for p in model.parts) and not model.is_point_cloud:
        # mixed point clouds and meshes: keep the meshes only
        dropped = sum(1 for p in model.parts if p.faces is None)
        warn(f"ignoring {dropped} point-only part(s) in a mesh model")
        model.parts = [p for p in model.parts if p.faces is not None]
    return model


def describe_images(images):
    if not images:
        return "no textures"
    sizes = {}
    for img in images:
        sizes[img.size] = sizes.get(img.size, 0) + 1
    detail = ", ".join(f"{n} x {w}x{h}" for (w, h), n in sorted(sizes.items(), reverse=True))
    return f"{len(images)} texture{'s' if len(images) != 1 else ''} ({detail})"


def describe_model(model):
    if model.is_point_cloud:
        return (f"point cloud, {model.vertex_count:,} points"
                + (", with colors" if model.colored else ""))
    text = (f"{len(model.parts)} part{'s' if len(model.parts) != 1 else ''}, "
            f"{model.triangle_count:,} triangles, {model.vertex_count:,} vertices, "
            + describe_images(model.images()))
    if model.colored:
        text += ", vertex colors"
    return text


# ------------------------------------------------------------------------------------------------
# PLY interchange with MeshLab (binary little endian, wedge texcoords + texnumber)
# ------------------------------------------------------------------------------------------------

PLY_TYPES = {"char": "i1", "uchar": "u1", "short": "i2", "ushort": "u2", "int": "i4", "uint": "u4",
             "float": "f4", "double": "f8", "int8": "i1", "uint8": "u1", "int16": "i2",
             "uint16": "u2", "int32": "i4", "uint32": "u4", "float32": "f4", "float64": "f8"}


def write_interchange_ply(path, vertices, faces, wedge_uv, texnumber, colors, ntextures):
    vfields = [("x", "<f4"), ("y", "<f4"), ("z", "<f4")]
    header = ["ply", "format binary_little_endian 1.0", f"comment {PROGRAM} {VERSION}"]
    header += [f"comment TextureFile texture_{i}.jpg" for i in range(ntextures)]
    header += [f"element vertex {len(vertices)}",
               "property float x", "property float y", "property float z"]
    if colors is not None:
        vfields += [("red", "u1"), ("green", "u1"), ("blue", "u1")]
        header += ["property uchar red", "property uchar green", "property uchar blue"]
    varr = np.empty(len(vertices), dtype=np.dtype(vfields))
    varr["x"], varr["y"], varr["z"] = vertices[:, 0], vertices[:, 1], vertices[:, 2]
    if colors is not None:
        varr["red"], varr["green"], varr["blue"] = colors[:, 0], colors[:, 1], colors[:, 2]

    ffields = [("n", "u1"), ("v", "<i4", (3,))]
    header += [f"element face {len(faces)}", "property list uchar int vertex_indices"]
    if wedge_uv is not None:
        ffields += [("m", "u1"), ("t", "<f4", (6,)), ("tn", "<i4")]
        header += ["property list uchar float texcoord", "property int texnumber"]
    farr = np.empty(len(faces), dtype=np.dtype(ffields))
    farr["n"] = 3
    farr["v"] = faces
    if wedge_uv is not None:
        farr["m"] = 6
        farr["t"] = wedge_uv
        farr["tn"] = texnumber
    header += ["end_header", ""]
    with open(path, "wb") as f:
        f.write("\n".join(header).encode("ascii"))
        f.write(varr.tobytes())
        f.write(farr.tobytes())


def read_interchange_ply(path):
    """Read the binary PLY MeshLab wrote back. Returns a dict of numpy arrays."""
    with open(path, "rb") as f:
        data = f.read()
    end = data.index(b"end_header\n") + len(b"end_header\n")
    elements = []
    for line in data[:end].decode("ascii", "replace").splitlines():
        tok = line.split()
        if not tok:
            continue
        if tok[0] == "format" and tok[1] != "binary_little_endian":
            fail(f"unexpected PLY format '{tok[1]}' from MeshLab")
        elif tok[0] == "element":
            elements.append((tok[1], int(tok[2]), []))
        elif tok[0] == "property":
            if tok[1] == "list":
                elements[-1][2].append((tok[4], PLY_TYPES[tok[2]], PLY_TYPES[tok[3]]))
            else:
                elements[-1][2].append((tok[2], PLY_TYPES[tok[1]], None))
    list_lengths = {"vertex_indices": 3, "vertex_index": 3, "texcoord": 6}
    result, offset = {}, end
    for name, count, props in elements:
        fields = []
        for pname, ctype, itype in props:
            if itype is None:
                fields.append((pname, "<" + ctype))
            else:
                if pname not in list_lengths:
                    fail(f"unexpected list property '{pname}' in MeshLab output")
                fields.append((pname + "__count", "<" + ctype))
                fields.append((pname, "<" + itype, (list_lengths[pname],)))
        dtype = np.dtype(fields)
        arr = np.frombuffer(data, dtype=dtype, count=count, offset=offset)
        offset += dtype.itemsize * count
        for pname, ctype, itype in props:
            if itype is not None and count and not (arr[pname + "__count"] == list_lengths[pname]).all():
                fail(f"MeshLab output has a non-triangular '{pname}' list")
        result[name] = arr
    if offset != len(data):
        fail("MeshLab output PLY has unexpected trailing data")
    return result


# ------------------------------------------------------------------------------------------------
# Geometry processing
# ------------------------------------------------------------------------------------------------

def material_key(m):
    return (id(m.image) if m.image is not None else None, m.color, m.double_sided, round(m.roughness, 3))


def combine_parts(model):
    """Concatenate all parts into one mesh, with one material index per face."""
    materials, index_of = [], {}
    textured, colored = model.textured, model.colored
    vlist, flist, wlist, tlist, clist = [], [], [], [], []
    offset = 0
    for part in model.parts:
        key = material_key(part.material)
        if key not in index_of:
            index_of[key] = len(materials)
            materials.append(part.material)
        mi = index_of[key]
        vlist.append(part.vertices)
        flist.append(part.faces.astype(np.int64) + offset)
        if textured:
            if part.uv is not None and part.material.image is not None:
                uv = np.nan_to_num(part.uv.astype(np.float32))
                wlist.append(uv[part.faces].reshape(-1, 6))
            else:
                wlist.append(np.zeros((len(part.faces), 6), dtype=np.float32))
            tlist.append(np.full(len(part.faces), mi, dtype=np.int32))
        if colored:
            if part.colors is not None:
                clist.append(part.colors[:, :3])
            else:
                clist.append(np.full((len(part.vertices), 3), 255, dtype=np.uint8))
        offset += len(part.vertices)
    mesh = {"vertices": np.concatenate(vlist).astype(np.float32),
            "faces": np.concatenate(flist).astype(np.int32),
            "wedge": np.concatenate(wlist) if textured else None,
            "texnumber": np.concatenate(tlist) if textured else None,
            "colors": np.concatenate(clist) if colored else None}
    return materials, mesh


def compute_target_faces(nfaces, args):
    if args.faces is not None:
        return max(4, int(args.faces))
    return max(4, int(round(nfaces * args.ratio)))


def simplify_mesh(mesh, materials, args, tmpdir):
    """Weld, clean and decimate with MeshLab. Empties `mesh` and returns the new arrays."""
    import pymeshlab

    vertices, faces, wedge, texnumber, colors = (mesh[k] for k in
                                                 ("vertices", "faces", "wedge", "texnumber", "colors"))
    textured, colored = wedge is not None, colors is not None
    nverts, nfaces = len(vertices), len(faces)
    pin = os.path.join(tmpdir, "in.ply")
    pout = os.path.join(tmpdir, "out.ply")
    t = Timer()
    write_interchange_ply(pin, vertices, faces, wedge, texnumber, colors, len(materials))
    del vertices, faces, wedge, texnumber, colors
    mesh.clear()                        # MeshLab has its own copy now; free ours
    ms = pymeshlab.MeshSet()
    ms.load_new_mesh(pin)
    if args.verbose:
        log(f"handed {nfaces:,} triangles to MeshLab ({t})")

    t = Timer()
    if args.weld:
        ms.meshing_remove_duplicate_vertices()
    if args.weld_distance > 0:
        ms.meshing_merge_close_vertices(threshold=pymeshlab.PureValue(args.weld_distance))
    ms.meshing_remove_duplicate_faces()
    ms.meshing_remove_null_faces()
    if args.min_part_size > 1:
        ms.meshing_remove_connected_component_by_face_number(mincomponentsize=int(args.min_part_size),
                                                             removeunref=True)
    ms.meshing_remove_unreferenced_vertices()
    m = ms.current_mesh()
    welded_verts, welded_faces = m.vertex_number(), m.face_number()
    if args.weld or args.weld_distance > 0:
        log(f"welded vertices: {nverts:,} -> {welded_verts:,}"
            + (f", removed {nfaces - welded_faces:,} degenerate or duplicate triangles"
               if welded_faces != nfaces else "")
            + (f" ({t})" if args.verbose else ""))
    elif welded_faces != nfaces:
        log(f"removed {nfaces - welded_faces:,} degenerate, duplicate or tiny-fragment triangles")

    target = compute_target_faces(welded_faces, args)
    if target < welded_faces:
        t = Timer()
        if textured:
            ms.meshing_decimation_quadric_edge_collapse_with_texture(
                targetfacenum=int(target), qualitythr=0.3, extratcoordw=1.0,
                preserveboundary=True, boundaryweight=1.0, optimalplacement=True,
                preservenormal=True, planarquadric=True)
        else:
            ms.meshing_decimation_quadric_edge_collapse(
                targetfacenum=int(target), qualitythr=0.3,
                preserveboundary=True, boundaryweight=1.0, preservenormal=True,
                preservetopology=False, optimalplacement=True, planarquadric=True,
                autoclean=True)
        ms.meshing_remove_unreferenced_vertices()
        m = ms.current_mesh()
        log(f"simplified: {welded_faces:,} -> {m.face_number():,} triangles "
            f"({100.0 * m.face_number() / max(1, welded_faces):.1f}%), "
            f"{welded_verts:,} -> {m.vertex_number():,} vertices"
            + (f" ({t})" if args.verbose else ""))
    else:
        log(f"no simplification needed: {welded_faces:,} triangles is already within the target")

    if m.face_number() == 0:
        fail("nothing left after simplification")
    ms.save_current_mesh(pout, binary=True, save_vertex_color=colored,
                         save_vertex_normal=False, save_wedge_texcoord=textured,
                         save_face_color=False)
    ms.clear()
    ply = read_interchange_ply(pout)
    v, f = ply["vertex"], ply["face"]
    result = {"vertices": np.stack([v["x"], v["y"], v["z"]], axis=1).astype(np.float32),
              "faces": np.asarray(f["vertex_indices"], dtype=np.int32),
              "wedge": None, "texnumber": None, "colors": None}
    if colored and "red" in v.dtype.names:
        result["colors"] = np.stack([v["red"], v["green"], v["blue"]], axis=1).astype(np.uint8)
    if textured:
        result["wedge"] = np.asarray(f["texcoord"], dtype=np.float32)
        if "texnumber" in f.dtype.names:
            result["texnumber"] = np.asarray(f["texnumber"], dtype=np.int32)
        else:
            result["texnumber"] = np.zeros(len(result["faces"]), dtype=np.int32)
    return result


def vertex_normals(vertices, faces):
    """Area-weighted smooth vertex normals."""
    tri = vertices[faces].astype(np.float64)
    fn = np.cross(tri[:, 1] - tri[:, 0], tri[:, 2] - tri[:, 0])
    normals = np.zeros((len(vertices), 3), dtype=np.float64)
    idx = faces.ravel()
    for c in range(3):
        normals[:, c] = np.bincount(idx, weights=np.repeat(fn[:, c], 3), minlength=len(vertices))
    length = np.linalg.norm(normals, axis=1)
    ok = length > 0
    normals[ok] /= length[ok, None]
    normals[~ok] = (0.0, 0.0, 1.0)
    return normals.astype(np.float32)


def split_by_material(vertices, faces, wedge, texnumber, colors, normals, materials):
    """Build one output part per material, splitting vertices along UV seams."""
    parts = []
    groups = [0] if texnumber is None else np.unique(texnumber).tolist()
    for mi in groups:
        sel = slice(None) if texnumber is None else (texnumber == mi)
        f = faces[sel]
        if len(f) == 0:
            continue
        material = materials[mi] if mi < len(materials) else materials[0]
        if wedge is not None and material.image is not None:
            w = wedge[sel].reshape(-1, 3, 2)
            keys = np.empty(f.size, dtype=[("v", "<i4"), ("u", "<f4"), ("t", "<f4")])
            keys["v"] = f.ravel()
            keys["u"] = w[:, :, 0].ravel()
            keys["t"] = w[:, :, 1].ravel()
            uniq, inverse = np.unique(keys, return_inverse=True)
            vidx = uniq["v"]
            uv = np.stack([uniq["u"], uniq["t"]], axis=1).astype(np.float32)
        else:
            vidx, inverse = np.unique(f.ravel(), return_inverse=True)
            uv = None
        new_faces = inverse.reshape(-1, 3).astype(np.int32)
        parts.append(Part(material.name, vertices[vidx], new_faces, uv=uv,
                          colors=None if colors is None else
                          np.concatenate([colors[vidx], np.full((len(vidx), 1), 255, np.uint8)], axis=1),
                          normals=None if normals is None else normals[vidx],
                          material=material))
    return parts


# ------------------------------------------------------------------------------------------------
# Textures
# ------------------------------------------------------------------------------------------------

def encode_texture(image, max_size, quality):
    from PIL import Image

    w, h = image.size
    scale = 1.0 if max_size <= 0 else min(1.0, max_size / float(max(w, h)))
    tw, th = max(1, int(round(w * scale))), max(1, int(round(h * scale)))
    has_alpha = ("A" in image.getbands()) or (image.mode == "P" and "transparency" in image.info)
    if has_alpha:
        image = image.convert("RGBA")
        has_alpha = int(np.asarray(image.getchannel("A")).min()) < 255
    if not has_alpha:
        if image.format == "JPEG" and scale < 1.0:
            image.draft("RGB", (tw, th))      # fast reduced-size JPEG decoding
        image = image.convert("RGB")
    if image.size != (tw, th):
        image = image.resize((tw, th), Image.Resampling.LANCZOS)
    buf = io.BytesIO()
    if has_alpha:
        image.save(buf, "PNG", optimize=True)
        return Texture(buf.getvalue(), "image/png", ".png", (tw, th))
    image.save(buf, "JPEG", quality=int(quality), optimize=True)
    return Texture(buf.getvalue(), "image/jpeg", ".jpg", (tw, th))


def encode_textures(parts, args, before=0):
    """Encode each distinct image once; attach the result to the materials."""
    done = {}
    after = 0
    sizes_in, sizes_out = set(), set()
    for part in parts:
        m = part.material
        if m is None or m.image is None or part.uv is None:
            continue
        key = id(m.image)
        if key not in done:
            t = Timer()
            width, height = m.image.size        # before encoding: draft-mode decoding shrinks the image object
            done[key] = encode_texture(m.image, args.texture_size, args.texture_quality)
            sizes_in.add(max(width, height))
            sizes_out.add(max(done[key].size))
            after += len(done[key].data)
            if args.verbose:
                log(f"texture {m.name}: {width}x{height} -> "
                    f"{done[key].size[0]}x{done[key].size[1]}, {human_size(len(done[key].data))} ({t})")
        m.texture = done[key]
    if done:
        log(f"textures: {len(done)} image{'s' if len(done) != 1 else ''}, longest side "
            f"{max(sizes_in)} -> {max(sizes_out)} px, JPEG quality {args.texture_quality}"
            + (f", {human_size(before)} -> {human_size(after)}" if before else ""))
    return list(done.values())


def texture_bytes_in_file(path):
    """Bytes of texture images stored in (or next to) the input file; for reporting only."""
    ext = ext_of(path)
    base = os.path.dirname(os.path.abspath(path))
    try:
        if ext == ".glb":
            with open(path, "rb") as f:
                magic, _, _ = struct.unpack("<4sII", f.read(12))
                if magic != b"glTF":
                    return 0
                length, _ = struct.unpack("<II", f.read(8))
                js = json.loads(f.read(length))
            views = js.get("bufferViews", [])
            return sum(views[i["bufferView"]]["byteLength"] for i in js.get("images", []) if "bufferView" in i)
        if ext == ".gltf":
            with open(path) as f:
                js = json.load(f)
            total = 0
            for image in js.get("images", []):
                uri = image.get("uri")
                if uri and not uri.startswith("data:") and os.path.exists(os.path.join(base, uri)):
                    total += os.path.getsize(os.path.join(base, uri))
                elif "bufferView" in image:
                    total += js["bufferViews"][image["bufferView"]]["byteLength"]
            return total
        if ext == ".obj":
            total, seen = 0, set()
            with open(path, errors="replace") as f:
                for _, line in zip(range(500), f):
                    if not line.startswith("mtllib"):
                        continue
                    for mtl in line.split()[1:]:
                        if not os.path.exists(os.path.join(base, mtl)):
                            continue
                        with open(os.path.join(base, mtl), errors="replace") as m:
                            for mline in m:
                                tok = mline.split()
                                if len(tok) > 1 and tok[0].lower().startswith("map_"):
                                    tex = os.path.join(base, tok[-1])
                                    if tex not in seen and os.path.exists(tex):
                                        seen.add(tex)
                                        total += os.path.getsize(tex)
            return total
    except Exception:
        return 0
    return 0


def bake_vertex_colors(part):
    """Sample the texture at each vertex, for formats that only carry vertex colors."""
    img = part.material.image.convert("RGB")
    arr = np.asarray(img)
    h, w = arr.shape[:2]
    u = np.mod(part.uv[:, 0], 1.0)
    v = np.mod(part.uv[:, 1], 1.0)
    x = np.clip((u * w).astype(np.int64), 0, w - 1)
    y = np.clip(((1.0 - v) * h).astype(np.int64), 0, h - 1)
    rgb = arr[y, x]
    return np.concatenate([rgb, np.full((len(rgb), 1), 255, np.uint8)], axis=1)


